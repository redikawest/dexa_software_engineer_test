{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@app/config": [
        "./libs/config/src/index.ts"
      ],
      "@app/config/*": [
        "./libs/config/src/*"
      ],
      "@app/clients": [
        "./libs/clients/src/index.ts"
      ],
      "@app/clients/*": [
        "./libs/clients/src/*"
      ],
      "@app/messaging": [
        "./libs/messaging/src/index.ts"
      ],
      "@app/messaging/*": [
        "./libs/messaging/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/attendance-service/tsconfig.app.json"
    },
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/auth-service/tsconfig.app.json"
    },
    {
      "path": "./apps/employee-service/tsconfig.app.json"
    },
    {
      "path": "./apps/log-service/tsconfig.app.json"
    }
  ]
}