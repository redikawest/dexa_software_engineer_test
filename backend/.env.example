NODE_ENV=development

GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
EMPLOYEE_SERVICE_PORT=3002
ATTENDANCE_SERVICE_PORT=3003

AUTH_SERVICE_URL=http://localhost:3001
EMPLOYEE_SERVICE_URL=http://localhost:3002
ATTENDANCE_SERVICE_URL=http://localhost:3003
LOG_SERVICE_URL=http://localhost:3004

DB_HOST=localhost
DB_PORT=5432
DB_USER=dexa
DB_PASSWORD=dexa_dev_password
DB_NAME=dexa_main
DB_LOGGING=false

SEED_ADMIN_PASSWORD=Admin-Dexa-2026
SEED_EMPLOYEE_PASSWORD=Employee-Dexa-2026

# Login tokens are signed with a private key (auth-service only) and checked with the public key
# (gateway only). Create the pair with: npm run keys:generate
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_ISSUER=dexa-auth
JWT_AUDIENCE=dexa-api
JWT_EXPIRES_IN_SECONDS=3600

CORS_ORIGINS=http://localhost:5173

LOGS_DB_HOST=localhost
LOGS_DB_PORT=5432
LOGS_DB_USER=dexa_logs
LOGS_DB_PASSWORD=dexa_logs_dev_password
LOGS_DB_NAME=dexa_logs

RABBITMQ_URL=amqp://dexa:dexa_dev_password@localhost:5672
LOG_SERVICE_PORT=3004
